---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';

const pageTitle = 'Codex Masterclass | Prompt Alchemist';
const pageDescription =
  'A warm, hands-on Codex masterclass for non-developers who want to use AI to turn ideas, workflows, and business problems into practical first versions.';
const tallyEmbedUrl =
  'https://tally.so/embed/NpRO8N?alignLeft=1&hideTitle=1&dynamicHeight=1';

const lessonNav = [
  { href: '#promise', label: 'Promise' },
  { href: '#workshop', label: 'Workshop' },
  { href: '#lesson-plan', label: 'Plan' },
  { href: '#who', label: 'Who it helps' },
  { href: '#outcomes', label: 'Outcomes' },
  { href: '#investment', label: 'Investment' },
  { href: '#faq', label: 'FAQ' },
  { href: '#waitlist', label: 'Waitlist' },
] as const;

const proofPoints = [
  { value: '4h', label: 'live, guided, practical workshop' },
  { value: '0', label: 'developer background required' },
  { value: '1', label: 'idea moved into a real first version' },
] as const;

const promiseCards = [
  {
    title: 'Stop collecting AI tips',
    body: 'Turn scattered tool knowledge into a simple operating loop you can reuse at work, in a side project, or for a business idea.',
  },
  {
    title: 'Direct the work clearly',
    body: 'Learn how to explain goals, context, examples, boundaries, and review criteria so Codex can help you produce useful outputs.',
  },
  {
    title: 'Leave with momentum',
    body: 'Build a first version, improve it with feedback, and walk away with a personal 30-day plan for using AI more deliberately.',
  },
] as const;

const workshopSteps = [
  {
    number: '01',
    title: 'Pick one real goal',
    body: 'Bring a workflow, idea, content system, internal tool, customer journey, or small business experiment.',
  },
  {
    number: '02',
    title: 'Shape it into instructions',
    body: 'Translate the idea into plain-English context that an AI build partner can act on.',
  },
  {
    number: '03',
    title: 'Build a first version',
    body: 'Use Codex to produce something concrete: a page, tool, plan, automation draft, or structured prototype.',
  },
  {
    number: '04',
    title: 'Review and improve',
    body: 'Learn what to check, what to refine, and what to ask next so the output becomes presentable.',
  },
] as const;

const projectExamples = [
  'Landing page for an idea',
  'Internal workflow helper',
  'Customer research script',
  'Content or lead magnet system',
  'Simple dashboard or tracker',
  'Personal AI operating playbook',
] as const;

const modules = [
  {
    number: '01',
    title: 'AI operator mindset',
    duration: 'Hour 1',
    promise: 'Understand what Codex changes for non-developers and where it can create leverage right away.',
    lessons: ['From chatbot user to AI operator', 'Choosing the right use case', 'Setting boundaries and success criteria'],
    lab: 'Turn one work or business problem into a clear Codex brief.',
  },
  {
    number: '02',
    title: 'Idea to first version',
    duration: 'Hour 2',
    promise: 'Use a simple instruction pattern to move from fuzzy idea to a visible output.',
    lessons: ['Goal, audience, context, examples', 'Asking for a plan before building', 'Guiding Codex without technical jargon'],
    lab: 'Create the first version of your selected idea.',
  },
  {
    number: '03',
    title: 'Improve and polish',
    duration: 'Hour 3',
    promise: 'Review AI output like an operator: clarity, flow, missing states, positioning, and usefulness.',
    lessons: ['Spotting weak AI output', 'Prompting for stronger UX and copy', 'Iterating without getting lost'],
    lab: 'Upgrade your first version using a review-and-improve loop.',
  },
  {
    number: '04',
    title: 'Your AI work system',
    duration: 'Hour 4',
    promise: 'Build a reusable way to use Codex across work, learning, side projects, and business experiments.',
    lessons: ['Personal AI work map', 'Codex vs ChatGPT vs human help', 'Next 30-day action plan'],
    lab: 'Leave with your Codex playbook and next project plan.',
  },
] as const;

const audiences = [
  {
    title: 'Professionals',
    body: 'You want to stay relevant, produce higher-quality work faster, and understand what AI can actually do for your role.',
  },
  {
    title: 'Founders and solopreneurs',
    body: 'You have ideas and need a faster way to test demand, explain the offer, and create a first usable version.',
  },
  {
    title: 'Managers and operators',
    body: 'You want to identify automation opportunities, write clearer briefs, and work better with technical teams.',
  },
  {
    title: 'Career switchers',
    body: 'You want practical AI fluency that compounds without waiting until you become a developer.',
  },
] as const;

const takeaways = [
  'Codex instruction template for any idea',
  'A first version or AI-assisted workflow started during class',
  'Review checklist for improving weak AI output',
  'Plain-English briefing method for technical work',
  '30-day AI upskilling and execution plan',
  'Confidence to guide AI tools and builders clearly',
] as const;

const pricing = [
  { name: 'Early waitlist', price: 'SGD 197', note: 'Best for the first validation cohort.' },
  { name: 'Regular seat', price: 'SGD 297', note: 'Recommended public cohort price after proof and testimonials.' },
  { name: 'Private team', price: 'From SGD 2,500', note: 'For companies, teams, and custom examples.' },
] as const;

const faqs = [
  {
    question: 'Do I need to know how to code?',
    answer: 'No. This masterclass is designed for non-developers. You need curiosity, a real goal, and willingness to try a guided workflow.',
  },
  {
    question: 'Will this be a lecture or a hands-on session?',
    answer: 'Hands-on. Every hour turns a concept into a guided exercise so you leave with a usable way of working, not just inspiration.',
  },
  {
    question: 'What should I bring?',
    answer: 'Bring one idea, workflow, business problem, or career project you want to move forward. The more real the goal, the more useful the session.',
  },
  {
    question: 'Why Codex instead of only ChatGPT?',
    answer: 'ChatGPT is strong for thinking, drafting, and exploring. Codex helps you turn clear instructions into working digital outputs and a more structured execution loop.',
  },
] as const;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <SiteHeader />
  <main class="codex-page">
    <section class="codex-hero" aria-labelledby="codex-hero-title">
      <div class="codex-hero__image" aria-hidden="true"></div>
      <div class="codex-hero__wash" aria-hidden="true"></div>
      <div class="codex-shell codex-hero__inner">
        <div class="codex-hero__copy">
          <h1 id="codex-hero-title">
            Build with AI, no coding background needed.
          </h1>
          <p class="codex-hero__lead">
            Codex Masterclass is a 4-hour hands-on workshop for professionals, founders, and operators who want to turn
            ideas into practical outputs with AI.
          </p>
          <p class="codex-hero__sublead">
            Bring one real goal. Learn how to brief Codex clearly, guide the build, review the result, and keep improving
            it after class.
          </p>
          <div class="codex-actions" aria-label="Primary actions">
            <a class="codex-button codex-button--primary" href="#waitlist">
              <span>Join the waitlist</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </a>
            <a class="codex-button codex-button--secondary" href="#lesson-plan">
              <span>See the 4-hour plan</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
            </a>
          </div>
        </div>

        <aside class="codex-operator-card" aria-label="Workshop operating loop">
          <div class="codex-card-topline">
            <span></span>
            <span></span>
            <span></span>
          </div>
          <p class="codex-card-label">Your AI execution loop</p>
          <ol>
            <li><span>Idea</span><strong>Pick one meaningful problem</strong></li>
            <li><span>Brief</span><strong>Give Codex useful context</strong></li>
            <li><span>Build</span><strong>Create a concrete first version</strong></li>
            <li><span>Improve</span><strong>Review, refine, and continue</strong></li>
          </ol>
        </aside>
      </div>
    </section>

    <section class="codex-proof-band" aria-label="Masterclass summary">
      <div class="codex-shell">
        <dl class="codex-proof-grid">
          {proofPoints.map((point) => (
            <div>
              <dt>{point.value}</dt>
              <dd>{point.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <nav class="codex-section-nav" aria-label="Codex masterclass page sections">
      <div class="codex-shell codex-section-nav__inner">
        {lessonNav.map(({ href, label }) => (
          <a href={href}>{label}</a>
        ))}
      </div>
    </nav>

    <section id="promise" class="codex-section codex-section--cream">
      <div class="codex-shell codex-section-heading">
        <p>Most people do not need another AI trend report.</p>
        <h2>They need a repeatable way to turn intent into output.</h2>
      </div>
      <div class="codex-shell codex-promise-grid">
        {promiseCards.map((card) => (
          <article class="codex-soft-card">
            <h3>{card.title}</h3>
            <p>{card.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="workshop" class="codex-section codex-section--white">
      <div class="codex-shell codex-workshop-layout">
        <div>
          <div class="codex-section-heading codex-section-heading--left">
            <p>How the workshop works</p>
            <h2>From idea to first version in one focused afternoon.</h2>
          </div>
          <p class="codex-section-copy">
            The goal is not to turn you into an engineer. The goal is to help you become better at directing AI-assisted
            work: clearer briefs, sharper review, faster iteration, and more confidence to keep building.
          </p>
          <div class="codex-project-list" aria-label="Example outputs">
            {projectExamples.map((item) => (
              <span>{item}</span>
            ))}
          </div>
        </div>

        <div class="codex-workflow-panel">
          {workshopSteps.map((step) => (
            <article>
              <div>{step.number}</div>
              <h3>{step.title}</h3>
              <p>{step.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="lesson-plan" class="codex-section codex-section--sage">
      <div class="codex-shell codex-section-heading">
        <p>4-hour lesson plan</p>
        <h2>Practical enough for beginners. Structured enough to keep using.</h2>
      </div>
      <div class="codex-shell codex-module-grid">
        {modules.map((module) => (
          <article class="codex-module-card">
            <div class="codex-module-card__header">
              <span>{module.number}</span>
              <small>{module.duration}</small>
            </div>
            <h3>{module.title}</h3>
            <p>{module.promise}</p>
            <ul>
              {module.lessons.map((lesson) => <li>{lesson}</li>)}
            </ul>
            <div class="codex-lab">
              <span>Exercise</span>
              <strong>{module.lab}</strong>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section id="who" class="codex-section codex-section--cream">
      <div class="codex-shell codex-split">
        <div class="codex-section-heading codex-section-heading--left">
          <p>Who this helps</p>
          <h2>For people who want leverage, not hype.</h2>
        </div>
        <div class="codex-audience-grid">
          {audiences.map((audience) => (
            <article class="codex-soft-card">
              <h3>{audience.title}</h3>
              <p>{audience.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="outcomes" class="codex-section codex-section--white">
      <div class="codex-shell codex-outcome-layout">
        <div class="codex-outcome-panel">
          <p>What changes after class</p>
          <h2>You stop waiting for perfect technical confidence and start moving ideas forward.</h2>
          <p>
            The durable skill is not memorising one tool. It is learning how to frame work, guide AI, inspect output, and
            keep improving with clear judgment.
          </p>
        </div>
        <ul class="codex-check-grid">
          {takeaways.map((takeaway) => (
            <li>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
              <span>{takeaway}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="investment" class="codex-section codex-section--cream">
      <div class="codex-shell codex-split">
        <div class="codex-section-heading codex-section-heading--left">
          <p>Investment</p>
          <h2>Accessible enough to start. Serious enough to create commitment.</h2>
          <p class="codex-section-copy">
            Recommended positioning: practical for ambitious individuals, premium enough to signal transformation, and
            expandable into team cohorts.
          </p>
        </div>
        <div class="codex-price-grid">
          {pricing.map((item, index) => (
            <article class:list={['codex-price-card', index === 1 && 'codex-price-card--featured']}>
              <p>{item.name}</p>
              <h3>{item.price}</h3>
              <span>{item.note}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="faq" class="codex-section codex-section--white">
      <div class="codex-shell codex-split">
        <div class="codex-section-heading codex-section-heading--left">
          <p>Questions</p>
          <h2>Designed to lower the barrier, not raise it.</h2>
        </div>
        <div class="codex-faq-list">
          {faqs.map((faq) => (
            <details>
              <summary>
                <span>{faq.question}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12h14" /></svg>
              </summary>
              <p>{faq.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </section>

    <section id="waitlist" class="codex-section codex-section--final">
      <div class="codex-shell codex-waitlist-card">
        <div>
          <p>Join the waitlist</p>
          <h2>Be first in line for the Codex Masterclass.</h2>
          <p>
            Small-room format, guided exercises, and practical AI execution skills for people who want to use AI with
            confidence.
          </p>
          <p class="codex-cohort-note">
            Proposed first cohorts (SGT): Saturday, 20 June 2026 or Saturday, 27 June 2026.
          </p>
        </div>
        <div class="codex-embed-shell">
          <iframe
            data-tally-src={tallyEmbedUrl}
            loading="lazy"
            width="100%"
            height="520"
            frameborder="0"
            marginheight="0"
            marginwidth="0"
            title="Codex Masterclass Waitlist Form"
            class="codex-embed-frame"
          ></iframe>
          <noscript>
            <p>
              JavaScript is required for the embedded form. Use this direct link instead:
              <a href="https://tally.so/r/NpRO8N">Codex Masterclass waitlist</a>.
            </p>
          </noscript>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</BaseLayout>

<script is:inline>
  var d = document;
  var w = 'https://tally.so/widgets/embed.js';
  var v = function () {
    if (typeof Tally !== 'undefined') {
      Tally.loadEmbeds();
    } else {
      d.querySelectorAll('iframe[data-tally-src]:not([src])').forEach(function (el) {
        el.src = el.dataset.tallySrc;
      });
    }
  };
  if (typeof Tally !== 'undefined') {
    v();
  } else if (d.querySelector('script[src="' + w + '"]') == null) {
    var s = d.createElement('script');
    s.src = w;
    s.onload = v;
    s.onerror = v;
    d.body.appendChild(s);
  }
</script>

<style>
  .codex-page {
    --codex-ink: var(--color-mist);
    --codex-body: var(--color-mist-dim);
    --codex-muted: var(--color-ink-muted);
    --codex-line: rgba(92, 87, 78, 0.62);
    --codex-line-strong: rgba(196, 165, 116, 0.42);
    --codex-accent: var(--color-ember);
    --codex-accent-dim: var(--color-ember-dim);
    --codex-card: rgba(37, 35, 32, 0.82);
    --codex-card-deep: rgba(20, 19, 17, 0.78);
    --codex-success: #9fcf9f;
    --codex-radius: 0.75rem;
    color: var(--codex-ink);
    background: var(--color-surface);
    font-family: var(--font-sans);
  }

  .codex-shell {
    width: min(100% - 2rem, 64rem);
    margin-inline: auto;
  }

  .codex-page [id] {
    scroll-margin-top: 16rem;
  }

  .codex-hero {
    position: relative;
    min-height: calc(86svh - 81px);
    overflow: hidden;
    border-bottom: 1px solid rgba(92, 87, 78, 0.55);
    background: var(--color-surface-deep);
  }

  .codex-hero__image,
  .codex-hero__wash {
    position: absolute;
    inset: 0;
  }

  .codex-hero__image {
    background-image: url('/img/codex-masterclass-hero-friendly.jpg');
    background-position: center right;
    background-size: cover;
  }

  .codex-hero__wash {
    background:
      linear-gradient(90deg, rgba(20, 19, 17, 0.98) 0%, rgba(20, 19, 17, 0.94) 41%, rgba(20, 19, 17, 0.68) 68%, rgba(20, 19, 17, 0.3) 100%),
      linear-gradient(180deg, rgba(20, 19, 17, 0) 58%, var(--color-surface) 100%);
  }

  .codex-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0.24;
    background-image:
      linear-gradient(115deg, transparent 0%, rgba(196, 165, 116, 0.16) 48%, transparent 56%),
      repeating-linear-gradient(90deg, transparent 0 46px, rgba(232, 217, 192, 0.055) 47px, transparent 48px);
  }

  .codex-hero__inner {
    position: relative;
    display: grid;
    min-height: calc(86svh - 81px);
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 25rem);
    gap: 2rem;
    align-items: center;
    padding-block: 4.5rem 5rem;
  }

  .codex-hero__copy {
    max-width: 43rem;
  }

  .codex-hero h1,
  .codex-section-heading h2,
  .codex-outcome-panel h2,
  .codex-waitlist-card h2 {
    margin: 0;
    color: var(--codex-ink);
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: 0;
  }

  .codex-hero h1 {
    max-width: 13ch;
    font-size: clamp(3rem, 6.1vw, 5.15rem);
    line-height: 1.02;
    text-shadow: 0 2px 16px rgba(0, 0, 0, 0.78);
  }

  .codex-hero__lead {
    max-width: 42rem;
    margin: 1.5rem 0 0;
    color: rgba(232, 217, 192, 0.94);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    line-height: 1.35;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.72);
  }

  .codex-hero__sublead,
  .codex-section-copy {
    color: var(--codex-muted);
    font-size: 1.06rem;
    line-height: 1.7;
  }

  .codex-hero__sublead {
    max-width: 36rem;
    margin: 1rem 0 0;
  }

  .codex-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .codex-button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    border-radius: 0.75rem;
    padding: 0.9rem 1.15rem;
    color: var(--codex-accent);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, border-color 180ms ease, background 180ms ease;
  }

  .codex-button svg,
  .codex-check-grid svg,
  .codex-faq-list svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.9;
  }

  .codex-button:hover {
    transform: translateY(-1px);
  }

  .codex-button--primary {
    border: 1px solid rgba(232, 217, 192, 0.28);
    background: linear-gradient(180deg, #d8bc83, #b89156);
    color: var(--color-surface-deep);
    box-shadow: 0 14px 34px -22px rgba(216, 188, 131, 0.85);
  }

  .codex-button--secondary {
    border: 1px solid rgba(196, 165, 116, 0.42);
    background: rgba(20, 19, 17, 0.44);
    color: var(--codex-accent);
    backdrop-filter: blur(10px);
  }

  .codex-operator-card {
    align-self: end;
    border: 1px solid var(--codex-line-strong);
    border-radius: var(--codex-radius);
    background:
      linear-gradient(145deg, rgba(232, 217, 192, 0.08), transparent 42%),
      rgba(20, 19, 17, 0.74);
    padding: 1rem;
    box-shadow:
      inset 0 0 0 1px rgba(20, 19, 17, 0.75),
      0 22px 58px -38px rgba(0, 0, 0, 0.86);
    backdrop-filter: blur(16px);
  }

  .codex-card-topline {
    display: flex;
    gap: 0.4rem;
  }

  .codex-card-topline span {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 999px;
    background: rgba(196, 165, 116, 0.36);
  }

  .codex-card-topline span:nth-child(2) {
    background: var(--codex-accent);
  }

  .codex-card-topline span:nth-child(3) {
    background: var(--codex-success);
  }

  .codex-card-label {
    margin: 1rem 0 0.9rem;
    color: var(--codex-body);
    font-family: var(--font-label);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .codex-operator-card ol {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .codex-operator-card li {
    display: grid;
    gap: 0.15rem;
    border: 1px solid var(--codex-line);
    border-radius: 0.8rem;
    background: rgba(37, 35, 32, 0.68);
    padding: 0.75rem;
  }

  .codex-operator-card span {
    color: var(--codex-accent);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .codex-operator-card strong {
    color: var(--codex-ink);
    font-size: 0.98rem;
    line-height: 1.3;
  }

  .codex-proof-band {
    border-block: 1px solid rgba(92, 87, 78, 0.55);
    background: rgba(20, 19, 17, 0.88);
    padding-block: 1rem;
  }

  .codex-proof-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    overflow: hidden;
    margin: 0;
    border: 1px solid rgba(92, 87, 78, 0.72);
    border-radius: var(--codex-radius);
    background: rgba(92, 87, 78, 0.48);
  }

  .codex-proof-grid div {
    background: rgba(37, 35, 32, 0.82);
    padding: 1.1rem;
  }

  .codex-proof-grid dt {
    color: var(--codex-accent);
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 800;
    line-height: 1;
  }

  .codex-proof-grid dd {
    margin: 0.45rem 0 0;
    color: var(--codex-body);
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .codex-section-nav {
    position: sticky;
    top: 81px;
