---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { groups, periods, getPattern } from '../data/periodic-table';
import { siteMeta } from '../data/vision';

const groupColorMap: Record<string, string> = {
  'group-perception':   'border-sky-500/40   bg-sky-500/[0.07]   text-sky-300',
  'group-reasoning':    'border-violet-500/40 bg-violet-500/[0.07] text-violet-300',
  'group-memory':       'border-amber-500/40  bg-amber-500/[0.07]  text-amber-300',
  'group-action':       'border-rose-500/40   bg-rose-500/[0.07]   text-rose-300',
  'group-coordination': 'border-emerald-500/40 bg-emerald-500/[0.07] text-emerald-300',
  'group-evaluation':   'border-orange-500/40 bg-orange-500/[0.07] text-orange-300',
  'group-governance':   'border-indigo-500/40 bg-indigo-500/[0.07] text-indigo-300',
};

const groupDotMap: Record<string, string> = {
  'group-perception':   'bg-sky-400',
  'group-reasoning':    'bg-violet-400',
  'group-memory':       'bg-amber-400',
  'group-action':       'bg-rose-400',
  'group-coordination': 'bg-emerald-400',
  'group-evaluation':   'bg-orange-400',
  'group-governance':   'bg-indigo-400',
};
---

<BaseLayout
  title={`Agentic Periodic Table — ${siteMeta.title}`}
  description="35 agentic AI design patterns arranged by function and autonomy level — a navigable reference for builders working with intelligent systems."
>
  <SiteHeader />

  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-border schematic-bg px-5 py-16 sm:px-8 sm:py-20">
      <div class="pointer-events-none absolute -right-24 top-0 h-96 w-96 rounded-full bg-ember/10 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -left-20 bottom-0 h-72 w-72 rounded-full bg-violet-500/5 blur-3xl" aria-hidden="true" />
      <div class="relative mx-auto max-w-5xl">
        <p class="font-label mb-3 text-[0.7rem] font-semibold uppercase tracking-[0.28em] text-ember">
          Prompt Alchemist · USP
        </p>
        <h1 class="font-display text-4xl font-semibold leading-tight text-mist sm:text-5xl lg:text-[2.75rem] lg:leading-[1.12]">
          Agentic Periodic Table
        </h1>
        <p class="mt-4 font-display text-xl italic text-ember sm:text-2xl">
          35 design patterns. Two axes. One number.
        </p>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-mist/88">
          Every agentic system is built from composable primitives. This table maps 35 patterns across
          <strong class="text-mist font-semibold">function</strong> (columns, left = more essential) and
          <strong class="text-mist font-semibold">autonomy level</strong> (rows, top = more directed).
          The <strong class="text-mist font-semibold">atomic number</strong> ranks each pattern by fundamentalness —
          1 is the most foundational primitive, 35 the most abstract.
        </p>
      </div>
    </section>

    <!-- Axis legend -->
    <section class="border-b border-border bg-surface-raised/30 px-5 py-10 sm:px-8">
      <div class="mx-auto max-w-5xl">
        <div class="grid gap-8 lg:grid-cols-3">
          <!-- Groups legend -->
          <div class="lg:col-span-2">
            <p class="font-label mb-4 text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-ember">
              Columns — Function (left = more essential)
            </p>
            <ul class="flex flex-wrap gap-2">
              {groups.map((g) => (
                <li class:list={['flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold', groupColorMap[g.color]]}>
                  <span class:list={['h-1.5 w-1.5 rounded-full', groupDotMap[g.color]]} />
                  {g.label}
                </li>
              ))}
            </ul>
          </div>
          <!-- Periods legend -->
          <div>
            <p class="font-label mb-4 text-[0.65rem] font-semibold uppercase tracking-[0.22em] text-ember">
              Rows — Autonomy (top = more directed)
            </p>
            <ol class="space-y-1.5">
              {periods.map((p) => (
                <li class="flex items-baseline gap-3 text-sm">
                  <span class="font-label w-4 shrink-0 text-right text-[0.65rem] font-semibold text-ember/70">P{p.id}</span>
                  <span class="font-semibold text-mist">{p.label}</span>
                </li>
              ))}
            </ol>
          </div>
        </div>

        <!-- Atomic number callout -->
        <div class="mt-8 rounded-lg border border-ember/20 bg-ember/[0.05] px-5 py-4">
          <p class="font-label mb-1 text-[0.62rem] font-semibold uppercase tracking-[0.2em] text-ember">
            Atomic number — Fundamentalness rank (1–35)
          </p>
          <p class="text-sm leading-relaxed text-mist/80">
            Lower = more foundational. Higher = more abstract. The number is hand-curated — it is
            not purely sequential, so a left-column P2 pattern (e.g. RAG = 5) can outrank a
            right-column P1 pattern (e.g. Prompt Guardrails = 11) when real-world usage warrants it.
          </p>
        </div>
      </div>
    </section>

    <!-- The table -->
    <section class="px-5 py-14 sm:px-8">
      <div class="mx-auto max-w-6xl">
        <!-- Horizontal scroll wrapper keeps the grid shape on all screen sizes -->
        <div class="overflow-x-auto -mx-5 px-5 sm:-mx-8 sm:px-8 pb-4">
          <div class="min-w-[680px]">

            <!-- Column headers -->
            <div class="mb-2 grid grid-cols-[3.5rem_repeat(7,minmax(0,1fr))] gap-1.5">
              <div />
              {groups.map((g) => (
                <div class:list={['rounded-md border px-1.5 py-2 text-center', groupColorMap[g.color]]}>
                  <p class="font-label text-[0.55rem] font-semibold uppercase tracking-[0.14em] leading-tight">{g.label}</p>
                </div>
              ))}
            </div>

            <!-- Rows -->
            <div class="space-y-1.5">
              {periods.map((period) => (
                <div class="grid grid-cols-[3.5rem_repeat(7,minmax(0,1fr))] gap-1.5">
                  <!-- Row label -->
                  <div class="flex flex-col items-center justify-center rounded-md border border-border bg-surface-raised/40 px-1 py-2 text-center">
                    <p class="font-label text-[0.62rem] font-bold uppercase tracking-[0.14em] text-ember">P{period.id}</p>
                    <p class="mt-0.5 font-label text-[0.5rem] font-semibold uppercase tracking-[0.08em] text-ink-muted leading-tight">{period.label}</p>
                  </div>

                  <!-- Cells -->
                  {groups.map((group) => {
                    const pattern = getPattern(period.id, group.id);
                    if (!pattern) return null;
                    return (
                      <div class="group/cell relative">
                        {/* Square tile — periodic-table style */}
                        <div
                          class:list={[
                            'aspect-square cursor-default rounded-md border p-2 flex flex-col transition-all duration-200 hover:scale-[1.08] hover:shadow-xl hover:z-10 relative',
                            groupColorMap[group.color],
                          ]}
                        >
                          <span class="font-mono text-[0.58rem] font-medium leading-none opacity-60 tabular-nums">{pattern.number}</span>
                          <div class="flex flex-1 items-center justify-center">
                            <p class="font-display text-xl font-bold leading-none text-mist sm:text-2xl">{pattern.symbol}</p>
                          </div>
                          <p class="font-label text-[0.47rem] font-semibold uppercase leading-tight tracking-[0.07em] text-mist/75 text-center line-clamp-2">{pattern.name}</p>
                        </div>

                        {/* Tooltip */}
                        <div class="pointer-events-none absolute left-0 top-full z-50 mt-2 hidden w-64 rounded-lg border border-border bg-surface-deep p-3 shadow-2xl group-hover/cell:block">
                          <div class="mb-2 flex items-center gap-2">
                            <span class="font-mono text-[0.6rem] text-ember/70">#{pattern.number}</span>
                            <p class="font-label text-[0.6rem] font-semibold uppercase tracking-[0.16em] text-ember">{pattern.name}</p>
                          </div>
                          <p class="text-xs leading-relaxed text-mist/85">{pattern.description}</p>
                        </div>
                      </div>
                    );
                  })}
                </div>
              ))}
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- Reading the table explainer -->
    <section class="border-t border-border bg-surface-raised/25 schematic-bg px-5 py-14 sm:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="section-ornament font-display text-3xl font-semibold text-mist sm:text-4xl">
          How to read this table
        </h2>
        <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {[
            {
              label: 'Atomic number = fundamentalness',
              body: 'Pattern #1 (Prompt Engineering) is the hydrogen of agentic systems — everything builds from it. Pattern #35 (Constitutional Alignment) only matters once you have a system complex enough to need self-governance.',
            },
            {
              label: 'Numbers are not sequential in the grid',
              body: 'RAG is #5 even though it sits in Period 2, because it is more universally foundational than right-column Period 1 patterns. Position and number give you different information — read both.',
            },
            {
              label: 'Left column = most essential',
              body: 'Perception patterns anchor the left; Governance anchors the right. Within any row, the further left, the more the pattern is a prerequisite for everything else in that period.',
            },
            {
              label: 'Same row — same trust level',
              body: 'Patterns in the same period operate at the same autonomy level and compose naturally together. A P2 reasoning pattern pairs well with a P2 memory pattern.',
            },
            {
              label: 'Same column — same job, different depth',
              body: 'Patterns in the same group do the same functional job at increasing autonomy levels. You can swap a P1 pattern for a P3 one as you scale trust in the system.',
            },
            {
              label: 'Molecules are real systems',
              body: 'Any real agent product is a molecule: a combination of patterns across groups and periods. A coding agent is typically P3/Rsn + P3/Act + P2/Evl working in concert.',
            },
          ].map((item) => (
            <div class="plate-card p-5">
              <p class="font-label mb-2 text-[0.62rem] font-semibold uppercase tracking-[0.18em] text-ember">{item.label}</p>
              <p class="text-sm leading-relaxed text-mist/85">{item.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>
